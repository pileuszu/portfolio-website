{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://pileuszu.github.io/portfolio-website",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "cmd /c rmdir /s /q .next 2>nul & next dev",
    "build": "next build",
    "build:images": "node scripts/convert-webp.js",
    "build:test": "npm run build && npm run test:images",
    "build:prod": "cross-env NEXT_PUBLIC_IS_PRODUCTION=true next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:images": "node scripts/test-images.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "next": "15.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.84.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "15.5.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^27.0.0",
    "sharp": "^0.34.5",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.2"
  }
}
